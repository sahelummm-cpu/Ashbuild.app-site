RewriteEngine On
RewriteBase /

# Prevent directory listing
Options -Indexes

# Ensure HTML files are always served as text/html (never download popups)
AddType text/html .html .htm
AddType text/css .css
AddType application/javascript .js

# If the requested file or directory exists in the root, serve it directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route all requests through index.php (handles subdomains and clean /policy, /terms URLs)
RewriteRule ^(.*)$ index.php [QSA,L]
